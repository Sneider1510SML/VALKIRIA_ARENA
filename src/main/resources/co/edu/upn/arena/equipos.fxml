<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.upn.arena.EquiposController"
      styleClass="pagina"
      spacing="14">

    <Label text="ESCUADRONES DE COMBATE // DELTA &amp; LOCUST" styleClass="titulo"/>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <VBox styleClass="tarjeta" spacing="10">
                <Label text="Registrar Escuadrón" styleClass="subtitulo"/>
                <HBox spacing="10">
                    <TextField fx:id="txtNombreEquipo" promptText="Nombre del escuadrón (ej. Escuadrón Delta)" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtJuego" promptText="Juego / Modo (ej. Gears of War - Ejecución)" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="10">
                    <Button text="Guardar Escuadrón" onAction="#guardarEquipo" styleClass="boton-principal"/>
                    <Button text="Limpiar" onAction="#limpiar"/>
                    <Button text="Eliminar" onAction="#eliminarEquipo" styleClass="boton-peligro"/>
                </HBox>
            </VBox>

            <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Escuadrón" prefWidth="180"/>
                    <TableColumn fx:id="colJuego" text="Juego / Modo" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="tarjeta" spacing="10" prefWidth="310">
            <Label text="Integrantes del Escuadrón" styleClass="subtitulo"/>
            <Label fx:id="lblEquipoActivo" text="Selecciona un escuadrón en la tabla"/>
            <ComboBox fx:id="cmbJugadoresLibres" promptText="Seleccionar soldado disponible" maxWidth="Infinity"/>
            <HBox spacing="8">
                <Button text="Agregar Soldado" onAction="#agregarJugador" styleClass="boton-principal" HBox.hgrow="ALWAYS"/>
                <Button text="Quitar" onAction="#quitarJugador" styleClass="boton-peligro"/>
            </HBox>
            <ListView fx:id="listaIntegrantes" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

</VBox>
